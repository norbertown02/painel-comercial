{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/gestao",
      "destination": "https://gestao-three-virid.vercel.app/gestao"
    },
    {
      "source": "/gestao/:path*",
      "destination": "https://gestao-three-virid.vercel.app/gestao/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/planos",
      "destination": "https://planonutricional.nutrialle.com.br",
      "permanent": false
    },
    {
      "source": "/planos/:path*",
      "destination": "https://planonutricional.nutrialle.com.br/:path*",
      "permanent": false
    }
  ]
}
